{
  "routes": [
    {
      "route": "/faculty-dashboard.html",
      "redirect": "/index.html",
      "statusCode": 301
    },
    {
      "route": "/bundles/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{html,js,css}",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    }
  ],
  "platform": {
    "apiRuntime": "node:22"
  }
}
