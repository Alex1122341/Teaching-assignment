  function validRequestResubmittedNotification(d){let before=get(requestPublicPath(d.requestId)).data;let after=getAfter(requestPublicPath(d.requestId)).data;let workflow=getAfter(requestWorkflowPath(d.requestId)).data;return facultyMember() && before.requesterUid == request.auth.uid
