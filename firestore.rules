rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function ready(){return signedIn() && profile().active == true && profile().role in ['owner','administrator','other_office','admin','editor','viewer','adfa_general','adfa_regular','hicc','visc','faculty','adc','lab'] && profile().get('mustChangePassword',false) == false;}
  function admin(){return ready() && profile().role in ['owner','administrator','other_office','admin','adfa_general','adfa_regular'];}
  function approver(){return ready() && profile().role in ['owner','administrator','other_office','adfa_general','adfa_regular'];}
  function general(){return ready() && profile().role in ['owner','adfa_general'];}
  function historyAll(){return ready() && profile().role in ['owner','administrator','admin','adfa_general','adfa_regular'];}
  function hicc(){return ready() && profile().role == 'hicc';}
  function facultyMember(){return ready() && profile().role in ['hicc','visc','faculty'];}
  function explicitRole(r){return r in ['owner','administrator','other_office','adfa_general','adfa_regular','admin','editor','viewer','hicc','visc','faculty','adc','lab'];}
  function restrictedOffice(){return signedIn() && profile().role in ['adc','lab'];}
  function privateReader(){return ready() && !restrictedOffice();}
  function validOfficeIdentity(d){return !(d.role in ['adc','lab']) || !d.keys().hasAny(['facultyId','facultyRoles']);}
  function facultyRole(r){return r in ['hicc','visc','faculty','editor','viewer'];}
  function validFacultyLink(d){return !facultyRole(d.role) || (d.facultyId is string && d.facultyId.size() > 0 && exists(/databases/$(database)/documents/faculty/$(d.facultyId)));}
  function validFacultyRoles(d){return !d.keys().hasAny(['facultyRoles']) || (d.facultyRoles is list && d.facultyRoles.size() > 0 && d.facultyRoles.size() <= 3 && d.facultyRoles.hasOnly(['hicc','visc','faculty']));}
  function ownFacultyRecord(){return ready() && resource.data.email is string && ((request.auth.token.email is string && resource.data.email == request.auth.token.email) || (profile().email is string && resource.data.email == profile().email));}
  function ownFacultyId(id){return facultyMember() && profile().facultyId is string && profile().facultyId == id;}
  function selfFacultyId(fid){return signedIn() && fid is string && fid.size() > 0 && exists(/databases/$(database)/documents/faculty/$(fid)) && get(/databases/$(database)/documents/faculty/$(fid)).data.email is string && ((request.auth.token.email is string && get(/databases/$(database)/documents/faculty/$(fid)).data.email == request.auth.token.email) || (profile().email is string && get(/databases/$(database)/documents/faculty/$(fid)).data.email == profile().email));}
  function selfPasswordCompletion(uid){return signedIn() && request.auth.uid == uid && resource.data.active == true && request.resource.data.active == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword','passwordChangedAt','updatedAt']) && request.resource.data.mustChangePassword == false && request.resource.data.passwordChangedAt == request.time && request.resource.data.updatedAt == request.time;}
  function generalUserCreate(){return general() && explicitRole(request.resource.data.role) && validFacultyLink(request.resource.data) && validFacultyRoles(request.resource.data) && validOfficeIdentity(request.resource.data) && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && request.resource.data.createdAt == request.time && request.resource.data.keys().hasOnly(['name','email','role','facultyRoles','facultyId','active','mustChangePassword','updatedBy','updatedByName','updatedAt','createdAt']);}
  function generalUserUpdate(uid){return general() && explicitRole(request.resource.data.role) && validFacultyLink(request.resource.data) && validFacultyRoles(request.resource.data) && validOfficeIdentity(request.resource.data) && request.resource.data.active is bool && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','role','facultyRoles','facultyId','active','mustChangePassword','updatedBy','updatedByName','updatedAt']) && (uid != request.auth.uid || (request.resource.data.role in ['owner','adfa_general'] && request.resource.data.active == true));}
  function validGroup(d){return d.name is string && d.ownerUid is string && d.courseIds is list && d.memberUids is list && d.ownerUid in d.memberUids && get(/databases/$(database)/documents/users/$(d.ownerUid)).data.role == 'hicc' && get(/databases/$(database)/documents/users/$(d.ownerUid)).data.active == true;}
  function generalGroupWrite(){return general() && validGroup(request.resource.data) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;}
  function hiccMemberUpdate(){return hicc() && resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.ownerUid in request.resource.data.memberUids && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids','updatedBy','updatedByName','updatedAt']);}
  function ownsRequestGroup(d){return hicc() && d.groupId is string && d.groupId.size() > 0 && exists(/databases/$(database)/documents/faculty_groups/$(d.groupId)) && get(/databases/$(database)/documents/faculty_groups/$(d.groupId)).data.ownerUid == request.auth.uid;}
  function specialReplacement(d){return d.requestType == 'faculty_swap' && d.toFaculty is map && d.toFaculty.get('kind','') in ['sessional','other'];}
  function validSpecialSwapReason(d){return !specialReplacement(d) || (d.reason is string && d.reason.size() > 0 && d.reason.size() <= 1000 && d.reason.matches('.*\\S.*'));}
  function validSelfSwap(d){return d.requestType == 'faculty_swap' && d.fromFaculty is map && d.toFaculty is map && ((d.fromFaculty.facultyId is string && selfFacultyId(d.fromFaculty.facultyId)) || (d.toFaculty.facultyId is string && selfFacultyId(d.toFaculty.facultyId)));}
  function validRequestCreate(){return facultyMember() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.requesterRole == profile().role && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time && request.resource.data.sessionId is string && request.resource.data.requestType in ['faculty_swap','session_edit'] && validSpecialSwapReason(request.resource.data) && (validSelfSwap(request.resource.data) || ownsRequestGroup(request.resource.data));}
  function validRequestDecision(){return approver() && resource.data.status == 'pending' && request.resource.data.status in ['approved','rejected'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedBy','approvedByName','approvedAt','appliedAt','rejectedBy','rejectedByName','rejectedAt','rejectionReason']) && ((request.resource.data.status == 'approved' && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time && request.resource.data.appliedAt == request.time) || (request.resource.data.status == 'rejected' && request.resource.data.rejectedBy == request.auth.uid && request.resource.data.rejectedAt == request.time));}
  function afcRead(d){return !restrictedOffice() && (historyAll() || d.requesterUid == request.auth.uid || d.reportToUid == request.auth.uid);}
  function afcCreate(){return facultyMember() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.facultyId == profile().facultyId && request.resource.data.reportToUid is string && request.resource.data.status == (request.resource.data.reportToUid.size() > 0 ? 'pending_report_to' : 'pending_admin') && request.resource.data.contactAddress is string && request.resource.data.contactAddress.size() > 0 && request.resource.data.contactAddress.size() <= 500 && request.resource.data.contactAddress.matches('.*\\S.*') && request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() > 0 && request.resource.data.contactPhone.size() <= 50 && request.resource.data.contactPhone.matches('.*\\S.*') && request.resource.data.applicantSignature.uid == request.auth.uid && request.resource.data.applicantSignature.attested == true && request.resource.data.submittedAt == request.time && request.resource.data.updatedAt == request.time;}
  function afcRecommend(){return resource.data.status == 'pending_report_to' && request.resource.data.status == 'pending_admin' && (request.auth.uid == resource.data.reportToUid || historyAll()) && request.resource.data.reportToSignature.uid == request.auth.uid && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reportToSignature','updatedAt']);}
  function afcReject(){return resource.data.status in ['pending_report_to','pending_admin'] && request.resource.data.status == 'rejected' && (historyAll() || request.auth.uid == resource.data.reportToUid) && request.resource.data.rejectedSignature.uid == request.auth.uid && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() > 0 && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','rejectionReason','rejectedSignature','updatedAt']);}
  function afcApprove(){return historyAll() && resource.data.status == 'pending_admin' && request.resource.data.status == 'approved' && request.resource.data.adminSignature.uid == request.auth.uid && request.resource.data.pdfChunkCount is int && request.resource.data.pdfChunkCount > 0 && request.resource.data.approvedAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminSignature','pdfChunkCount','pdfSha256','pdfByteLength','approvedAt','updatedAt']);}
  function bulkFacultyImportChange(){return request.resource.data.diff(resource.data).affectedKeys().hasAny(['awayFromCampusRecords','awayFromCampusSource','awayFromCampusImportedAt','awayFromCampusImportedBy','facultySummary2026_27','facultySummarySource2026_27','facultySummaryImportedAt','facultySummaryImportedBy','workloadPolicy2026_27','workloadPolicySource2026_27','workloadPolicyImportedAt2026_27','workloadPolicyImportedBy2026_27','bulkImportedAt','bulkImportedBy']);}
  function bulkFacultyImportCreate(){return request.resource.data.keys().hasAny(['awayFromCampusRecords','facultySummary2026_27','workloadPolicy2026_27','bulkImportedAt','bulkImportedBy']);}
  function bulkSessionImportChange(){return request.resource.data.diff(resource.data).affectedKeys().hasAny(['sourceWorkbook','sourceSchema','bulkImportedAt','bulkImportedBy']);}
  function clientCreatedSessionHasNoAuditMarker(){return !request.resource.data.keys().hasAny(['auditEventId']);}
  function clientKeptSessionAuditMarker(){return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['auditEventId']);}

  function systemStateExists(){return exists(/databases/$(database)/documents/settings/system_state);}
  function teachingLocked(){return systemStateExists() && get(/databases/$(database)/documents/settings/system_state).data.get('teachingDataWriteLocked',false) == true;}
  function teachingWritesOpen(){return !teachingLocked();}
  function maintenanceOwner(){return general() && teachingLocked() && get(/databases/$(database)/documents/settings/system_state).data.get('maintenanceOwnerUid','') == request.auth.uid && get(/databases/$(database)/documents/settings/system_state).data.get('activeImportId','') is string && get(/databases/$(database)/documents/settings/system_state).data.get('activeImportId','').size() > 0;}
  function maintenanceOwnerFor(id){return maintenanceOwner() && get(/databases/$(database)/documents/settings/system_state).data.get('activeImportId','') == id;}
  function maintenanceFacultyUpdate(){return maintenanceOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachingDoeModel2026_27','assignedTeachingDOE','doeAssignedTeachingDOE','teachingSummary2026_27','facultySummary2026_27','facultySummaryStatus2026_27','facultySummarySource2026_27','facultySummaryImportedAt','facultySummaryImportedBy','updatedBy','updatedByName']);}
  function validSystemStateCreate(){return general() && request.resource.data.keys().hasOnly(['teachingDataWriteLocked','maintenanceMode','activeImportId','maintenanceOwnerUid','maintenanceOwnerName','maintenanceStartedAt','lastCompletedImportId','lastCompletedImportAt']) && request.resource.data.teachingDataWriteLocked == true && request.resource.data.maintenanceMode in ['bulk_import','restore'] && request.resource.data.activeImportId is string && request.resource.data.activeImportId.size() > 0 && request.resource.data.maintenanceOwnerUid == request.auth.uid && request.resource.data.maintenanceStartedAt == request.time && existsAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)) && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)).data.startedBy == request.auth.uid && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)).data.status == 'APPLYING';}
  function validSystemStateAcquire(){return general() && resource.data.get('teachingDataWriteLocked',false) == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachingDataWriteLocked','maintenanceMode','activeImportId','maintenanceOwnerUid','maintenanceOwnerName','maintenanceStartedAt']) && request.resource.data.teachingDataWriteLocked == true && request.resource.data.maintenanceMode in ['bulk_import','restore'] && request.resource.data.activeImportId is string && request.resource.data.activeImportId.size() > 0 && request.resource.data.maintenanceOwnerUid == request.auth.uid && request.resource.data.maintenanceStartedAt == request.time && existsAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)) && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)).data.startedBy == request.auth.uid && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(request.resource.data.activeImportId)).data.status == 'APPLYING';}
  function validSystemStateOwnerModeChange(){return maintenanceOwner() && request.resource.data.teachingDataWriteLocked == true && request.resource.data.activeImportId == resource.data.activeImportId && request.resource.data.maintenanceOwnerUid == resource.data.maintenanceOwnerUid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maintenanceMode']) && request.resource.data.maintenanceMode in ['bulk_import','restore'];}
  function validSystemStateTakeover(){return general() && resource.data.get('teachingDataWriteLocked',false) == true && request.resource.data.teachingDataWriteLocked == true && request.resource.data.activeImportId == resource.data.activeImportId && request.resource.data.maintenanceOwnerUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maintenanceOwnerUid','maintenanceOwnerName']) && existsAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)) && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)).data.get('recoveryTakenOverBy','') == request.auth.uid && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)).data.get('recoveryTakeoverReason','') is string && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)).data.get('recoveryTakeoverReason','').size() > 0;}
  function validSystemStateUnlock(){return maintenanceOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachingDataWriteLocked','maintenanceMode','activeImportId','maintenanceOwnerUid','maintenanceOwnerName','maintenanceStartedAt','lastCompletedImportId','lastCompletedImportAt']) && request.resource.data.teachingDataWriteLocked == false && request.resource.data.maintenanceMode == 'none' && request.resource.data.activeImportId == '' && request.resource.data.maintenanceOwnerUid == '' && existsAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)) && getAfter(/databases/$(database)/documents/bulk_import_jobs/$(resource.data.activeImportId)).data.status in ['COMPLETED','RESTORED'];}
  function validImportJobCreate(id){return general() && request.resource.data.importId == id && request.resource.data.startedBy == request.auth.uid && request.resource.data.status == 'APPLYING' && existsAfter(/databases/$(database)/documents/settings/system_state) && getAfter(/databases/$(database)/documents/settings/system_state).data.teachingDataWriteLocked == true && getAfter(/databases/$(database)/documents/settings/system_state).data.activeImportId == id && getAfter(/databases/$(database)/documents/settings/system_state).data.maintenanceOwnerUid == request.auth.uid;}
  function validImportJobUpdate(id){return maintenanceOwnerFor(id) && request.resource.data.get('importId','') == resource.data.get('importId','') && request.resource.data.get('sourceFingerprint','') == resource.data.get('sourceFingerprint','') && request.resource.data.get('sourceWorkbook','') == resource.data.get('sourceWorkbook','') && request.resource.data.get('schemaVersion','') == resource.data.get('schemaVersion','') && request.resource.data.get('startedBy','') == resource.data.get('startedBy','') && request.resource.data.get('startedAt',null) == resource.data.get('startedAt',null) && request.resource.data.get('backupFingerprint','') == resource.data.get('backupFingerprint','');}
  function validImportJobTakeover(id){return general() && teachingLocked() && get(/databases/$(database)/documents/settings/system_state).data.activeImportId == id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['previousMaintenanceOwnerUid','previousMaintenanceOwnerName','recoveryTakenOverBy','recoveryTakenOverByName','recoveryTakenOverAt','recoveryTakeoverReason','lastUpdatedAt']) && request.resource.data.recoveryTakenOverBy == request.auth.uid && request.resource.data.recoveryTakeoverReason is string && request.resource.data.recoveryTakeoverReason.size() > 0 && getAfter(/databases/$(database)/documents/settings/system_state).data.maintenanceOwnerUid == request.auth.uid;}

  match /users/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || general() || (facultyMember() && facultyRole(resource.data.role)));
   allow list: if general() || (facultyMember() && facultyRole(resource.data.role));
   allow create: if generalUserCreate();
   allow update: if generalUserUpdate(uid) || selfPasswordCompletion(uid);
   allow delete: if false;
  }
  match /faculty_groups/{id} {
   allow read: if privateReader() && (admin() || request.auth.uid == resource.data.ownerUid || request.auth.uid in resource.data.memberUids);
   allow create: if generalGroupWrite() && request.resource.data.createdAt == request.time;
   allow update: if generalGroupWrite() || hiccMemberUpdate();
   allow delete: if general();
  }
  match /calendar_sessions/{id} {
   allow read: if ready();
   allow write: if false;
  }
  match /sessions/{id} {
   allow read: if privateReader();
   allow create: if (teachingWritesOpen() && admin() && clientCreatedSessionHasNoAuditMarker() && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && (!request.resource.data.keys().hasAny(['sourceWorkbook','sourceSchema','bulkImportedAt','bulkImportedBy']) || general())) || maintenanceOwner();
   allow update: if (teachingWritesOpen() && admin() && clientKeptSessionAuditMarker() && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && (!bulkSessionImportChange() || general())) || maintenanceOwner();
   allow delete: if (teachingWritesOpen() && admin()) || maintenanceOwner();
  }
  match /faculty/{id} {
   allow get: if admin() || ownFacultyId(id);
   allow list: if admin();
   allow create: if teachingWritesOpen() && admin() && request.resource.data.updatedBy == request.auth.uid && (!bulkFacultyImportCreate() || general());
   allow update: if (teachingWritesOpen() && admin() && request.resource.data.updatedBy == request.auth.uid && (!bulkFacultyImportChange() || general())) || maintenanceFacultyUpdate();
   allow delete: if teachingWritesOpen() && admin();
  }
  match /change_requests/{id} {
   allow read: if approver() || (signedIn() && !restrictedOffice() && resource.data.requesterUid == request.auth.uid);
   allow create: if teachingWritesOpen() && validRequestCreate();
   allow update: if teachingWritesOpen() && validRequestDecision();
   allow delete: if false;
  }
  match /settings/system_state {
   allow read: if ready();
   allow create: if validSystemStateCreate();
   allow update: if validSystemStateAcquire() || validSystemStateOwnerModeChange() || validSystemStateTakeover() || validSystemStateUnlock();
   allow delete: if false;
  }
  match /settings/{id} {
   allow read: if admin();
   allow read: if privateReader() && id == 'faculty_swap_index';
   allow write: if id != 'system_state' && ((id in ['faculty_index','schedule_stats','faculty_swap_index','faculty_swap_map'] && ((teachingWritesOpen() && admin()) || maintenanceOwner())) || (id == 'faculty_summary_2026_27' && ((teachingWritesOpen() && general()) || maintenanceOwner())) || (!(id in ['faculty_index','schedule_stats','faculty_swap_index','faculty_swap_map','faculty_summary_2026_27']) && admin()));
  }
  match /bulk_import_jobs/{importId} {
   allow read: if general();
   allow create: if validImportJobCreate(importId);
   allow update: if validImportJobUpdate(importId) || validImportJobTakeover(importId);
   allow delete: if false;
   match /stale_batches/{batchId} {
    allow read: if general();
    allow create,update: if maintenanceOwnerFor(importId);
    allow delete: if false;
   }
   match /restore_delete_batches/{batchId} {
    allow read: if general();
    allow create,update: if maintenanceOwnerFor(importId);
    allow delete: if false;
   }
   match /events/{eventId} {
    allow read: if general();
    allow create: if maintenanceOwnerFor(importId) && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time;
    allow update,delete: if false;
   }
  }
  match /public_info/{id} {allow read: if ready(); allow create,update: if general() && request.resource.data.messages is list && request.resource.data.messages.size() <= 10 && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; allow delete: if false;}
  match /public_schedule/{id} {
   allow read: if privateReader() && id == 'ccc_events';
   allow create,update: if id == 'ccc_events' && general()
    && request.resource.data.keys().hasOnly(['events','count','facultyCount','source','updatedBy','updatedByName','updatedAt'])
    && request.resource.data.events is list && request.resource.data.events.size() <= 1000
    && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /session_change_log/{id} {
   allow read: if privateReader() && (historyAll() || resource.data.changedBy == request.auth.uid);
   allow create: if teachingWritesOpen() && admin() && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time;
   allow update: if teachingWritesOpen() && admin() && resource.data.changedBy == request.auth.uid && request.resource.data.changedBy == resource.data.changedBy && request.resource.data.changedAt == resource.data.changedAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changes','changedByEmail','changedByName']);
   allow delete: if false;
  }
  match /faculty_change_log/{id} {
   allow read: if privateReader() && (historyAll() || resource.data.changedBy == request.auth.uid);
   allow create: if teachingWritesOpen() && admin() && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time;
   allow update: if teachingWritesOpen() && admin() && resource.data.changedBy == request.auth.uid && request.resource.data.changedBy == resource.data.changedBy && request.resource.data.changedAt == resource.data.changedAt && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['changes','facultyName','changedByEmail','changedByName']);
   allow delete: if false;
  }
  match /account_audit/{id} {
   allow read: if privateReader() && (historyAll() || resource.data.changedBy == request.auth.uid);
   allow create: if privateReader() && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time && (general() || (hicc() && request.resource.data.action == 'group_members_updated' && get(/databases/$(database)/documents/faculty_groups/$(request.resource.data.groupId)).data.ownerUid == request.auth.uid));
   allow update,delete: if false;
  }
  match /audit_events/{id} {allow read: if privateReader() && (historyAll() || resource.data.changedBy == request.auth.uid); allow write: if false;}
  match /afc_requests/{id} {
   allow read: if ready() && afcRead(resource.data);
   allow create: if afcCreate();
   allow update: if privateReader() && (afcRecommend() || afcReject() || afcApprove());
   allow delete: if false;
   match /pdf_chunks/{part} {
    allow read: if ready() && afcRead(get(/databases/$(database)/documents/afc_requests/$(id)).data);
    allow create: if historyAll() && getAfter(/databases/$(database)/documents/afc_requests/$(id)).data.status == 'approved' && request.resource.data.index is int && request.resource.data.base64 is string && request.resource.data.sha256 == getAfter(/databases/$(database)/documents/afc_requests/$(id)).data.pdfSha256;
    allow update,delete: if false;
   }
  }
  match /afc_audit/{id} {allow read: if privateReader() && (historyAll() || resource.data.changedBy == request.auth.uid || resource.data.requesterUid == request.auth.uid || resource.data.reportToUid == request.auth.uid); allow create: if privateReader() && request.resource.data.changedBy == request.auth.uid && request.resource.data.changedAt == request.time; allow update,delete: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
