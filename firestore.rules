rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function profile(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function readySignedIn(){let p=profile();return p.active == true && p.role in ['developer','owner','administrator','other_office','admin','editor','viewer','adfa_general','adfa_regular','hicc','visc','faculty','adc','lab'] && p.get('mustChangePassword',false) == false;}
  function ready(){return signedIn() && readySignedIn();}
  function admin(){return ready() && profile().role in ['developer','owner','administrator','other_office','admin','adfa_general','adfa_regular'];}
  function approver(){return ready() && profile().role in ['developer','owner','administrator','other_office','adfa_general','adfa_regular'];}
  function general(){return ready() && profile().role in ['developer','owner','adfa_general'];}
  function historyAll(){return ready() && profile().role in ['developer','owner','administrator','admin','adfa_general','adfa_regular'];}
  function hicc(){return ready() && profile().role == 'hicc';}
  function facultyMember(){return ready() && profile().role in ['hicc','visc','faculty'];}
  function explicitRole(r){return r in ['developer','owner','administrator','other_office','adfa_general','adfa_regular','admin','editor','viewer','hicc','visc','faculty','adc','lab'];}
  function developer(){return ready() && profile().role == 'developer';}
  function restrictedOffice(){return signedIn() && profile().role in ['adc','lab'];}
  function adc(){return ready() && profile().role in ['developer','adc'];}
  function lab(){return ready() && profile().role in ['developer','lab'];}
  function adfaApprover(){return ready() && profile().role in ['developer','owner','administrator','admin','adfa_general','adfa_regular'];}
  function officeForRole(r){return r == 'adc' ? 'adc' : (r == 'lab' ? 'lab' : (r in ['developer','owner','administrator','admin','adfa_general','adfa_regular'] ? 'adfa' : ''));}
  function officeUser(){return ready() && officeForRole(profile().role) != '';}
  function officeName(){return ready() ? officeForRole(profile().role) : '';}
  function requestPublicPath(id){return /databases/$(database)/documents/change_requests/$(id);}
  function requestWorkflowPath(id){return /databases/$(database)/documents/change_request_workflow/$(id);}
  function requestApprovalPath(id,office){return /databases/$(database)/documents/change_request_approvals/$(id + '_' + office);}
  function requestPrivatePath(id){return /databases/$(database)/documents/change_request_private/$(id);}
  function routedRequest(d){return d.get('requestSchema','') == 'office-routing-v1';}
  function publicSessionMapValid(d){return d is map && d.keys().hasOnly(['course','courseName','year','semester','week','date','start','end','timeUnknown','type','topic','room','instructor']);}
  function publicRequestKeysValid(d){return d.keys().hasOnly(['requestSchema','requesterUid','requesterName','requesterRole','sessionId','requestType','scope','groupId','groupName','status','revision','basePublic','patchPublic','currentFacultyName','proposedFacultyName','editableFields','requesterMessage','reason','course','date','topic','requestedAt','updatedAt','withdrawnBy','withdrawnAt','appliedRevision','appliedAt'])
   && publicSessionMapValid(d.basePublic) && publicSessionMapValid(d.patchPublic)
   && d.status in ['pending','update_required','approved','rejected','withdrawn']
   && d.requesterName is string && d.requesterRole is string && d.scope is string && d.groupId is string && d.groupName is string
   && d.currentFacultyName is string && d.proposedFacultyName is string && d.editableFields is list && d.editableFields.hasOnly(['course','courseName','year','semester','week','date','start','end','timeUnknown','type','topic','room','instructor','assignments','facultyIds'])
   && d.requesterMessage is string && d.reason is string
   && d.get('withdrawnBy','') is string && (d.get('withdrawnAt',null) == null || d.withdrawnAt is timestamp)
   && d.get('appliedRevision',0) is int && (d.get('appliedAt',null) == null || d.appliedAt is timestamp);}
  function routedPrivateShapeValid(d){return d.keys().hasOnly(['requestId','requesterUid','revision','assignmentChange','updatedAt'])
   && d.assignmentChange is map && d.assignmentChange.keys().hasOnly(['assignmentIndex','from','to'])
   && d.assignmentChange.get('from',{}) is map && d.assignmentChange.get('to',{}) is map
   && d.assignmentChange.get('from',{}).keys().hasOnly(['facultyId','candidateKey','kind'])
   && d.assignmentChange.get('to',{}).keys().hasOnly(['facultyId','candidateKey','kind']);}
  function routedSpecialReplacement(id){return existsAfter(requestPrivatePath(id)) && getAfter(requestPrivatePath(id)).data.assignmentChange.get('to',{}).get('kind','') in ['sessional','other'];}
  function routedSelfSwap(id){return existsAfter(requestPrivatePath(id)) && (selfFacultyId(getAfter(requestPrivatePath(id)).data.assignmentChange.get('from',{}).get('facultyId','')) || selfFacultyId(getAfter(requestPrivatePath(id)).data.assignmentChange.get('to',{}).get('facultyId','')));}
  function routedScopeCreate(id,d){return (d.requestType == 'session_edit' && d.scope == 'hicc' && ownsRequestGroup(d)) || (d.requestType == 'faculty_swap' && ((d.scope == 'hicc' && ownsRequestGroup(d)) || (d.scope == 'self' && routedSelfSwap(id))));}
  function validRoutedRequestCreate(id){let d=request.resource.data;return facultyMember() && routedRequest(d) && publicRequestKeysValid(d)
   && d.requesterUid == request.auth.uid && d.requesterRole == profile().role && d.status == 'pending' && d.revision == 1
   && d.requestedAt == request.time && d.updatedAt == request.time && d.sessionId is string && d.sessionId.size() > 0
   && d.requestType in ['faculty_swap','session_edit'] && routedScopeCreate(id,d)
   && (!routedSpecialReplacement(id) || (d.reason.size() > 0 && d.reason.size() <= 1000 && d.reason.matches('.*\\S.*')));}
  function requestFieldChanged(parent,field){return parent.patchPublic.get(field,parent.basePublic.get(field,null)) != parent.basePublic.get(field,null);}
  function requestFinalType(parent){return parent.patchPublic.get('type',parent.basePublic.get('type',''));}
  function requestFacultyChange(parent){return parent.requestType == 'faculty_swap' || requestFieldChanged(parent,'instructor');}
  function workflowScopesValid(d){let adcFields=d.scopes.get('adc',[]);let labFields=d.scopes.get('lab',[]);let adfaFields=d.scopes.get('adfa',[]);return
   d.requiredOffices is list && d.requiredOffices.size() > 0 && d.requiredOffices.size() <= 3 && d.requiredOffices.hasOnly(['adc','lab','adfa'])
   && adcFields is list && labFields is list && adfaFields is list
   && adcFields.hasOnly(['course','courseName','year','semester','week','date','start','end','timeUnknown','type','room','topic'])
   && labFields.hasOnly(['topic']) && adfaFields.hasOnly(['assignments','facultyIds','instructor'])
   && (d.finalType != 'LAB' || !('topic' in adcFields)) && (labFields.size() == 0 || d.finalType == 'LAB')
   && ((adcFields.size() > 0) == ('adc' in d.requiredOffices)) && ((labFields.size() > 0) == ('lab' in d.requiredOffices)) && ((adfaFields.size() > 0) == ('adfa' in d.requiredOffices))
   && d.hasFacultyChange == (adfaFields.size() > 0);}
  function workflowMatchesRequest(d,parent){let adcFields=d.scopes.get('adc',[]);let labFields=d.scopes.get('lab',[]);let adfaFields=d.scopes.get('adfa',[]);let finalType=requestFinalType(parent);return workflowScopesValid(d)
   && d.finalType == finalType && d.hasFacultyChange == requestFacultyChange(parent)
   && (('course' in adcFields) == requestFieldChanged(parent,'course')) && (('courseName' in adcFields) == requestFieldChanged(parent,'courseName'))
   && (('year' in adcFields) == requestFieldChanged(parent,'year')) && (('semester' in adcFields) == requestFieldChanged(parent,'semester')) && (('week' in adcFields) == requestFieldChanged(parent,'week'))
   && (('date' in adcFields) == requestFieldChanged(parent,'date')) && (('start' in adcFields) == requestFieldChanged(parent,'start')) && (('end' in adcFields) == requestFieldChanged(parent,'end'))
   && (('timeUnknown' in adcFields) == requestFieldChanged(parent,'timeUnknown')) && (('type' in adcFields) == requestFieldChanged(parent,'type')) && (('room' in adcFields) == requestFieldChanged(parent,'room'))
   && (('topic' in adcFields) == (finalType != 'LAB' && requestFieldChanged(parent,'topic'))) && (('topic' in labFields) == (finalType == 'LAB' && requestFieldChanged(parent,'topic')))
   && ((parent.requestType != 'faculty_swap' || (('assignments' in adfaFields) && ('instructor' in adfaFields))) && (('instructor' in adfaFields) == requestFacultyChange(parent)));}
  function validRoutedWorkflowCreate(id){let d=request.resource.data;let parent=getAfter(requestPublicPath(id)).data;return parent.requesterUid == request.auth.uid && routedRequest(parent)
   && d.keys().hasOnly(['requestId','revision','requiredOffices','hasFacultyChange','finalType','scopes','scopeSignatures','updatedAt'])
   && d.requestId == id && d.revision == 1 && d.updatedAt == request.time && d.scopes is map && d.scopeSignatures is map
   && d.scopes.keys().hasOnly(['adc','lab','adfa']) && d.scopeSignatures.keys().hasOnly(['adc','lab','adfa']) && workflowMatchesRequest(d,parent);}
  function validRoutedApprovalCreate(id){let d=request.resource.data;let workflow=getAfter(requestWorkflowPath(d.requestId)).data;let parent=getAfter(requestPublicPath(d.requestId)).data;return parent.requesterUid == request.auth.uid && routedRequest(parent)
   && d.keys().hasOnly(['id','requestId','office','revision','fields','scopeSignature','status','decidedBy','decidedByName','decidedAt','pushBackReason','updatedAt'])
   && id == d.requestId + '_' + d.office && d.office in ['adc','lab','adfa'] && d.office in workflow.requiredOffices
   && d.revision == 1 && d.fields == workflow.scopes.get(d.office,[]) && d.scopeSignature == workflow.scopeSignatures.get(d.office,'')
   && d.status == 'pending' && d.decidedBy == '' && d.decidedByName == '' && d.decidedAt == null && d.pushBackReason == '' && d.updatedAt == request.time;}
  function validRoutedPrivateCreate(id){let d=request.resource.data;let parent=getAfter(requestPublicPath(id)).data;let workflow=getAfter(requestWorkflowPath(id)).data;return parent.requesterUid == request.auth.uid && routedRequest(parent) && parent.requestType == 'faculty_swap' && workflow.hasFacultyChange == true
   && routedPrivateShapeValid(d) && d.requestId == id && d.requesterUid == request.auth.uid && d.revision == 1 && d.updatedAt == request.time;}
  function approvalShapeValid(d){return d.keys().hasOnly(['id','requestId','office','revision','fields','scopeSignature','status','decidedBy','decidedByName','decidedAt','pushBackReason','updatedAt'])
   && d.office in ['adc','lab','adfa'] && d.fields is list && d.scopeSignature is string && d.status in ['pending','approved','push_back','rejected','cancelled']
   && d.decidedBy is string && d.decidedByName is string && d.pushBackReason is string;}
  function approvalMatchesWorkflow(id,d,workflow){return approvalShapeValid(d) && d.id == id && id == d.requestId + '_' + d.office && d.office in workflow.requiredOffices
   && d.fields == workflow.scopes.get(d.office,[]) && d.scopeSignature == workflow.scopeSignatures.get(d.office,'');}
  function resubmitChanged(before,after,field){return before.patchPublic.get(field,before.basePublic.get(field,null)) != after.patchPublic.get(field,after.basePublic.get(field,null));}
  function resubmitScheduleChanged(before,after){return resubmitChanged(before,after,'date') || resubmitChanged(before,after,'start') || resubmitChanged(before,after,'end');}
  function officeReturned(before,oldWorkflow,office){return oldWorkflow.scopes.get(office,[]).toSet().intersection(before.editableFields.toSet()).size() > 0
   || (office == 'adfa' && before.editableFields.hasAny(['assignments','facultyIds','instructor']));}
  function officeDecisionParentMatches(before,after,approval){let changed=after.diff(before).affectedKeys();return changed.hasOnly(['status','editableFields','requesterMessage','updatedAt']) && after.updatedAt == request.time && after.editableFields is list && after.requesterMessage is string
   && ((approval.status == 'approved' && after.status == before.status && after.editableFields == before.editableFields && after.requesterMessage == before.requesterMessage)
    || (approval.status == 'push_back' && after.status == 'update_required' && after.requesterMessage.size() > 0 && after.requesterMessage.size() <= 1000
        && after.editableFields.hasAll(before.editableFields) && after.editableFields.hasAll(approval.fields)
        && after.editableFields.toSet().difference(before.editableFields.toSet()).hasOnly(approval.fields))
    || (approval.status == 'rejected' && after.status == 'rejected' && after.editableFields.size() == 0 && after.requesterMessage.size() <= 1000));}
  function developerDecisionOn(id,office){return developer() && exists(requestApprovalPath(id,office)) && existsAfter(requestApprovalPath(id,office))
   && get(requestApprovalPath(id,office)).data.status == 'pending' && getAfter(requestApprovalPath(id,office)).data.status in ['approved','push_back','rejected']
   && getAfter(requestApprovalPath(id,office)).data.decidedBy == request.auth.uid && getAfter(requestApprovalPath(id,office)).data.decidedAt == request.time;}
  function developerDecisionOffice(id){return developerDecisionOn(id,'adc') ? 'adc' : (developerDecisionOn(id,'lab') ? 'lab' : (developerDecisionOn(id,'adfa') ? 'adfa' : ''));}
  function decisionOffice(id){return developer() ? developerDecisionOffice(id) : officeName();}
  function validRoutedOfficeRequestUpdate(id){let before=resource.data;let after=request.resource.data;let actorOffice=decisionOffice(id);return actorOffice != '' && routedRequest(before) && before.status in ['pending','update_required'] && officeDecisionParentMatches(before,after,getAfter(requestApprovalPath(id,actorOffice)).data);}
  function validOfficeApprovalDecision(id,d,actorOffice){let parentBefore=get(requestPublicPath(d.requestId)).data;let parentAfter=getAfter(requestPublicPath(d.requestId)).data;let changed=d.diff(resource.data).affectedKeys();return routedRequest(parentBefore) && resource.data.office == actorOffice && resource.data.status == 'pending' && d.requestId == resource.data.requestId && d.office == resource.data.office && d.revision == resource.data.revision && d.fields == resource.data.fields && d.scopeSignature == resource.data.scopeSignature
   && changed.hasOnly(['status','decidedBy','decidedByName','decidedAt','pushBackReason','updatedAt']) && d.status in ['approved','push_back','rejected'] && d.decidedBy == request.auth.uid && d.decidedAt == request.time && d.updatedAt == request.time
   && ((d.status == 'push_back' && d.pushBackReason.size() > 0 && d.pushBackReason.size() <= 1000) || (d.status != 'push_back' && d.pushBackReason == '')) && officeDecisionParentMatches(parentBefore,parentAfter,d);}
  function validOfficeApprovalCancel(id,d,actorOffice){let parentAfter=getAfter(requestPublicPath(d.requestId)).data;let changed=d.diff(resource.data).affectedKeys();return resource.data.office != actorOffice && resource.data.status in ['pending','push_back'] && d.status == 'cancelled' && changed.hasOnly(['status','updatedAt']) && d.updatedAt == request.time && parentAfter.status == 'rejected' && getAfter(requestApprovalPath(d.requestId,actorOffice)).data.status == 'rejected';}
  function validRequesterApprovalResubmitUpdate(id,d,parentBefore,parentAfter,changed){let oldWorkflow=get(requestWorkflowPath(d.requestId)).data;let newWorkflow=getAfter(requestWorkflowPath(d.requestId)).data;return d.status == 'pending'
   ? (d.requestId == resource.data.requestId && d.office == resource.data.office && d.revision == parentAfter.revision && approvalMatchesWorkflow(id,d,newWorkflow) && d.decidedBy == '' && d.decidedByName == '' && d.decidedAt == null && d.pushBackReason == '' && d.updatedAt == request.time
      && (officeReturned(parentBefore,oldWorkflow,d.office) || !(d.office in oldWorkflow.requiredOffices) || (d.office == 'adfa' && oldWorkflow.hasFacultyChange == true && resubmitScheduleChanged(parentBefore,parentAfter))))
   : (d.status == 'cancelled' && resource.data.status in ['pending','push_back'] && changed.hasOnly(['status','updatedAt']) && d.updatedAt == request.time && !(d.office in newWorkflow.requiredOffices));}
  function validRequesterApprovalUpdate(id,d){let parentBefore=get(requestPublicPath(d.requestId)).data;let parentAfter=getAfter(requestPublicPath(d.requestId)).data;let changed=d.diff(resource.data).affectedKeys();return parentBefore.requesterUid == request.auth.uid
   && (parentAfter.status == 'withdrawn'
      ? (resource.data.status in ['pending','push_back'] && d.status == 'cancelled' && changed.hasOnly(['status','updatedAt']) && d.updatedAt == request.time)
      : (parentBefore.status == 'update_required' && parentAfter.status == 'pending' && validRequesterApprovalResubmitUpdate(id,d,parentBefore,parentAfter,changed)));}
  function validRoutedOfficeDecision(id){let d=request.resource.data;let actorOffice=developer() ? developerDecisionOffice(d.requestId) : officeName();return teachingWritesOpen() && approvalShapeValid(d) && (actorOffice != '' ? (resource.data.office == actorOffice ? validOfficeApprovalDecision(id,d,actorOffice) : validOfficeApprovalCancel(id,d,actorOffice)) : validRequesterApprovalUpdate(id,d));}
  function validRoutedApprovalResubmitCreate(id){let d=request.resource.data;let parentBefore=get(requestPublicPath(d.requestId)).data;let parentAfter=getAfter(requestPublicPath(d.requestId)).data;let oldWorkflow=get(requestWorkflowPath(d.requestId)).data;let newWorkflow=getAfter(requestWorkflowPath(d.requestId)).data;return teachingWritesOpen() && parentBefore.requesterUid == request.auth.uid && parentBefore.status == 'update_required' && parentAfter.status == 'pending'
   && d.revision == parentAfter.revision && approvalMatchesWorkflow(id,d,newWorkflow) && !(d.office in oldWorkflow.requiredOffices)
   && d.status == 'pending' && d.decidedBy == '' && d.decidedByName == '' && d.decidedAt == null && d.pushBackReason == '' && d.updatedAt == request.time;}
  function validRoutedRequesterWithdraw(id){let before=resource.data;let after=request.resource.data;let changed=after.diff(before).affectedKeys();return facultyMember() && routedRequest(before) && before.requesterUid == request.auth.uid
   && before.status in ['pending','update_required'] && after.status == 'withdrawn' && after.revision == before.revision
   && changed.hasOnly(['status','editableFields','requesterMessage','withdrawnBy','withdrawnAt','updatedAt']) && after.editableFields is list && after.editableFields.size() == 0 && after.requesterMessage == ''
   && after.withdrawnBy == request.auth.uid && after.withdrawnAt == request.time && after.updatedAt == request.time;}
  function validRoutedRequesterResubmit(id){let before=resource.data;let after=request.resource.data;let changedPublic=after.patchPublic.diff(before.patchPublic).affectedKeys();let changed=after.diff(before).affectedKeys();let newWorkflow=getAfter(requestWorkflowPath(id)).data;return facultyMember() && routedRequest(before) && before.requesterUid == request.auth.uid
   && before.status == 'update_required' && after.status == 'pending' && after.revision == before.revision + 1 && after.updatedAt == request.time
   && changed.hasOnly(['patchPublic','proposedFacultyName','reason','status','revision','editableFields','requesterMessage','course','date','topic','updatedAt'])
   && publicSessionMapValid(after.patchPublic) && after.proposedFacultyName is string && after.reason is string && after.editableFields is list && after.requesterMessage is string
   && changedPublic.hasOnly(before.editableFields) && (changedPublic.size() > 0 || after.proposedFacultyName != before.proposedFacultyName)
   && after.editableFields.size() == 0 && after.requesterMessage == ''
   && after.course == after.patchPublic.get('course',before.course) && after.date == after.patchPublic.get('date',before.date) && after.topic == after.patchPublic.get('topic',before.topic)
   && (after.proposedFacultyName == before.proposedFacultyName || (before.editableFields.hasAny(['assignments','facultyIds','instructor']) && after.patchPublic.get('instructor','') == after.proposedFacultyName))
   && (after.reason == before.reason || before.editableFields.hasAny(['assignments','facultyIds','instructor']))
   && newWorkflow.requestId == id && newWorkflow.revision == after.revision && newWorkflow.updatedAt == request.time && workflowMatchesRequest(newWorkflow,after)
   && (!routedSpecialReplacement(id) || (after.reason.size() > 0 && after.reason.size() <= 1000 && after.reason.matches('.*\\S.*')));}
  function validRoutedWorkflowResubmit(id){let d=request.resource.data;let beforeParent=get(requestPublicPath(id)).data;let afterParent=getAfter(requestPublicPath(id)).data;return facultyMember() && beforeParent.requesterUid == request.auth.uid && beforeParent.status == 'update_required' && afterParent.status == 'pending'
   && resource.data.requestId == id && d.keys().hasOnly(['requestId','revision','requiredOffices','hasFacultyChange','finalType','scopes','scopeSignatures','updatedAt'])
   && d.requestId == id && d.revision == afterParent.revision && d.updatedAt == request.time && d.scopes is map && d.scopeSignatures is map
   && d.scopes.keys().hasOnly(['adc','lab','adfa']) && d.scopeSignatures.keys().hasOnly(['adc','lab','adfa']) && workflowMatchesRequest(d,afterParent);}
  function validRoutedPrivateTarget(t){return t is map && t.keys().hasOnly(['candidateKey','kind'])
   && ((t.get('candidateKey','') is string && t.get('candidateKey','').size() > 0 && t.get('kind','') == '') || (t.get('candidateKey','') == '' && t.get('kind','') in ['sessional','other']));}
  function validRoutedPrivateResubmit(id){let d=request.resource.data;let beforeParent=get(requestPublicPath(id)).data;let afterParent=getAfter(requestPublicPath(id)).data;return facultyMember() && beforeParent.requesterUid == request.auth.uid && beforeParent.status == 'update_required' && afterParent.status == 'pending'
   && beforeParent.editableFields.hasAny(['assignments','facultyIds','instructor']) && routedPrivateShapeValid(d) && d.requestId == id && d.requesterUid == resource.data.requesterUid
   && d.revision == afterParent.revision && d.updatedAt == request.time && d.assignmentChange.assignmentIndex == resource.data.assignmentChange.assignmentIndex && d.assignmentChange.from == resource.data.assignmentChange.from
   && validRoutedPrivateTarget(d.assignmentChange.to) && d.diff(resource.data).affectedKeys().hasOnly(['revision','assignmentChange','updatedAt'])
   && (d.assignmentChange.to.get('kind','') == '' || (afterParent.reason.size() > 0 && afterParent.reason.size() <= 1000 && afterParent.reason.matches('.*\\S.*')));}
  function requiredApprovalMatches(id,workflow,office){let approval=get(requestApprovalPath(id,office)).data;return approval.status == 'approved' && approval.fields == workflow.scopes.get(office,[]) && approval.scopeSignature == workflow.scopeSignatures.get(office,'');}
  function approvedScope(id,workflow,office){return !(office in workflow.requiredOffices) || (exists(requestApprovalPath(id,office)) && requiredApprovalMatches(id,workflow,office));}
  function allRequiredApproved(id,workflow){return approvedScope(id,workflow,'adc') && approvedScope(id,workflow,'lab') && approvedScope(id,workflow,'adfa');}
  function routedApplyContextValid(id,before,after,workflow){let actorOffice=officeName();return officeUser() && routedRequest(before) && before.status == 'pending' && after.status == 'approved'
   && before.revision == after.revision && after.appliedRevision == before.revision && after.appliedAt == request.time && after.updatedAt == request.time
   && workflow.requestId == id && workflow.revision == before.revision && workflowMatchesRequest(workflow,before) && allRequiredApproved(id,workflow)
   && (developer() || actorOffice in workflow.requiredOffices) && (!workflow.hasFacultyChange || developer() || actorOffice == 'adfa');}
  function validRoutedApply(id){let before=resource.data;let after=request.resource.data;let workflow=get(requestWorkflowPath(id)).data;return routedApplyContextValid(id,before,after,workflow)
   && after.diff(before).affectedKeys().hasOnly(['status','editableFields','requesterMessage','appliedRevision','appliedAt','updatedAt'])
   && after.editableFields is list && after.editableFields.size() == 0 && after.requesterMessage == '';}
  function validRoutedRequesterUpdate(id){return request.resource.data.status == 'withdrawn' ? validRoutedRequesterWithdraw(id) : validRoutedRequesterResubmit(id);}
  function validRoutedOfficeUpdate(id){return request.resource.data.status == 'approved' ? validRoutedApply(id) : validRoutedOfficeRequestUpdate(id);}
  function validRoutedRequestUpdate(id){return resource.data.requesterUid == request.auth.uid ? validRoutedRequesterUpdate(id) : validRoutedOfficeUpdate(id);}
  function sourceMatchesPublicPatch(before,after,parent){return
   after.get('course',null) == parent.patchPublic.get('course',before.get('course',null)) && after.get('courseName',null) == parent.patchPublic.get('courseName',before.get('courseName',null))
   && after.get('year',null) == parent.patchPublic.get('year',before.get('year',null)) && after.get('semester',null) == parent.patchPublic.get('semester',before.get('semester',null)) && after.get('week',null) == parent.patchPublic.get('week',before.get('week',null))
   && after.get('date',null) == parent.patchPublic.get('date',before.get('date',null)) && after.get('start',null) == parent.patchPublic.get('start',before.get('start',null)) && after.get('end',null) == parent.patchPublic.get('end',before.get('end',null))
   && after.get('timeUnknown',null) == parent.patchPublic.get('timeUnknown',before.get('timeUnknown',null)) && after.get('type',null) == parent.patchPublic.get('type',before.get('type',null))
   && after.get('topic',null) == parent.patchPublic.get('topic',before.get('topic',null)) && after.get('room',null) == parent.patchPublic.get('room',before.get('room',null));}
  function routedSessionApplyFor(id,rid){let parentBefore=get(requestPublicPath(rid)).data;let parentAfter=getAfter(requestPublicPath(rid)).data;let changed=request.resource.data.diff(resource.data).affectedKeys();return parentBefore.sessionId == id && routedRequest(parentBefore) && parentBefore.status == 'pending' && parentAfter.status == 'approved' && parentAfter.appliedRevision == parentBefore.revision && parentAfter.appliedAt == request.time
   && request.resource.data.get('approvalRevision',0) == parentBefore.revision && changed.hasOnly(['course','courseName','year','semester','week','date','start','end','timeUnknown','type','room','topic','updatedBy','updatedByName','updatedAt','approvalRequestId','approvalRevision'])
   && sourceMatchesPublicPatch(resource.data,request.resource.data,parentBefore) && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time && calendarMatchesSourceAfter(id);}
