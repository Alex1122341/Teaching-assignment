  function afcCreate(){return facultyMember() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.facultyId == profile().facultyId && request.resource.data.reportToUid is string && request.resource.data.status == (request.resource.data.reportToUid.size() > 0 ? 'pending_report_to' : 'pending_admin') && request.resource.data.contactAddress is string && request.resource.data.contactAddress.size() > 0 && request.resource.data.contactAddress.size() <= 500 && request.resource.data.contactAddress.matches('.*\\S.*') && request.resource.data.contactPhone is string && request.resource.data.contactPhone.size() > 0 && request.resource.data.contactPhone.size() <= 50 && request.resource.data.contactPhone.matches('.*\\S.*') && request.resource.data.applicantSignature.uid == request.auth.uid && request.resource.data.applicantSignature.attested == true && request.resource.data.termsAccepted == true && request.resource.data.termsVersion == 'ucvm-afc-terms-page2-v1' && request.resource.data.termsSource == 'absence-from-campus-app.pdf#page=2' && request.resource.data.termsAcceptedAt == request.time && request.resource.data.submittedAt == request.time && request.resource.data.updatedAt == request.time;}
