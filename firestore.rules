  function validRequestCreate(){return facultyMember() && request.resource.data.requesterUid == request.auth.uid && request.resource.data.requesterRole == profile().role && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time && request.resource.data.sessionId is string && request.resource.data.requestType in ['faculty_swap','session_edit'] && validSpecialSwapReason(request.resource.data) && (validSelfSwap(request.resource.data) || ownsRequestGroup(request.resource.data));}
