  function validRequestAssignedNotification(d){let parent=getAfter(requestPublicPath(d.requestId)).data;let workflow=getAfter(requestWorkflowPath(d.requestId)).data;return facultyMember() && parent.requesterUid == request.auth.uid && parent.status == 'pending' && parent.revision == 1
