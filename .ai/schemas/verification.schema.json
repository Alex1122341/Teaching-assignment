{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VISTA verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "head_sha",
    "source_digest",
    "spec_digest",
    "started_at",
    "finished_at",
    "checks"
  ],
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "command",
          "result",
          "exit_code",
          "skipped",
          "reason",
          "log"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "unit",
              "server",
              "build",
              "emulator",
              "browser",
              "demo",
              "authenticated"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT RUN"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "skipped": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 2000
          },
          "log": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          }
        }
      }
    }
  }
}
