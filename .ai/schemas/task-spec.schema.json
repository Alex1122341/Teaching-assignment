{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VISTA task-spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "title",
    "category",
    "risk",
    "preferred_implementer",
    "problem_statement",
    "current_behavior",
    "required_behavior",
    "business_rules",
    "roles_affected",
    "expected_files",
    "acceptance_criteria",
    "required_tests",
    "forbidden_changes",
    "known_dependencies",
    "open_questions",
    "protected_changes",
    "role_checks"
  ],
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "category": {
      "type": "string",
      "enum": [
        "ui",
        "workflow",
        "debugging",
        "automation",
        "infrastructure",
        "security",
        "documentation"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "preferred_implementer": {
      "type": "string",
      "enum": [
        "hy4",
        "deepseek",
        "codex"
      ]
    },
    "problem_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "current_behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "required_behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "roles_affected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "expected_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "required_tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "unit",
          "server",
          "build",
          "emulator",
          "browser",
          "demo",
          "authenticated"
        ]
      }
    },
    "forbidden_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "known_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "protected_changes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "role_checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "source",
          "scenario",
          "expected"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    }
  }
}
