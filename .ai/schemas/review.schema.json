{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VISTA review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue",
    "stage",
    "model",
    "head_sha",
    "source_digest",
    "spec_digest",
    "criteria",
    "blocking_findings",
    "warnings",
    "remaining_risk",
    "human_checks",
    "reviewed_at"
  ],
  "properties": {
    "issue": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stage": {
      "type": "string",
      "enum": [
        "adversarial",
        "final"
      ]
    },
    "model": {
      "type": "string",
      "enum": [
        "hy4",
        "deepseek",
        "codex",
        "sol"
      ]
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "spec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT TESTED",
              "NOT APPLICABLE"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "remaining_risk": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "human_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
